# This cell: which edge images it runs and which hostnames the
# pre-provisioned routers claim (certificates are requested for them).
MNX_IMAGE_TAG=main
# Where the images come from: ghcr.io, or central's registry cache on a
# cell central makes (written by its deploys, with a credential per deploy).
MNX_REGISTRY=ghcr.io
MNX_API_HOST=api.monastryx.ai
MNX_HASURA_HOST=hasura.monastryx.ai
# Central only: the console's old name redirected to its name (the
# console-legacy service, activated by COMPOSE_PROFILES=central). A cell
# leaves all three empty.
COMPOSE_PROFILES=
MNX_CONSOLE_HOST=
MNX_CONSOLE_LEGACY_HOST=
